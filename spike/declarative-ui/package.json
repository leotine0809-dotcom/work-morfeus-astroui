{
  "name": "declarative-ui",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "npm run gate:static && tsc -b && vite build",
    "gate:static": "node gates/contrast.mjs && node gates/theme.mjs && tsx src/contracts.ts --check",
    "gate:contrast": "node gates/contrast.mjs",
    "gate:theme": "node gates/theme.mjs",
    "gate:contracts": "tsx src/contracts.ts --check",
    "gate:browser": "node gates/browser.mjs",
    "gate:screenshot": "node gates/screenshot.mjs",
    "contracts": "tsx src/contracts.ts",
    "verify": "npm run build && npm run gate:browser && npm run gate:screenshot && npm test",
    "lint": "oxlint",
    "preview": "vite preview",
    "generate": "tsx src/generate.ts",
    "test": "vitest run"
  },
  "dependencies": {
    "@fontsource-variable/geist": "^5.3.0",
    "@json-render/core": "^0.20.0",
    "@json-render/react": "^0.20.0",
    "@radix-ui/react-dialog": "^1.1.23",
    "@tailwindcss/vite": "^4.3.3",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "lucide-react": "^1.40.0",
    "radix-ui": "^1.6.7",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "react-resizable-panels": "^4.12.3",
    "shadcn": "^4.20.1",
    "sonner": "^2.0.8",
    "tailwind-merge": "^3.6.0",
    "tailwindcss": "^4.3.3",
    "tw-animate-css": "^1.4.0",
    "zod": "^4.5.4"
  },
  "devDependencies": {
    "@types/node": "^24.13.3",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.4",
    "@vitejs/plugin-react": "^6.1.0",
    "axe-core": "^4.13.0",
    "culori": "^4.0.2",
    "oxlint": "^1.79.0",
    "pixelmatch": "^7.2.0",
    "pngjs": "^7.0.0",
    "puppeteer-core": "^25.9.0",
    "tsx": "^4.23.13",
    "typescript": "~6.0.2",
    "vite": "^8.2.2",
    "vitest": "^4.1.11"
  }
}
